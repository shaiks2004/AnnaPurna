# Local PostgreSQL/PostGIS configuration. Do not commit real credentials.
POSTGRES_DB=annapurna
POSTGRES_USER=annapurna
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Spring Boot local connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=annapurna
DB_USERNAME=annapurna
DB_PASSWORD=change-me

# Base64-encoded, randomly generated 256-bit HMAC key for local JWT signing.
# Generate your own value; this placeholder is intentionally unusable.
ANNAPURNA_JWT_SECRET=
ANNAPURNA_JWT_ISSUER=annapurna-api
ANNAPURNA_JWT_AUDIENCE=annapurna-clients
